<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yujian.admin.mapper.SysEmployeeMapper">

    <resultMap id="EmployeeResult" type="com.yujian.common.system.domain.SysEmployee">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="empNo" column="emp_no"/>
        <result property="username" column="username"/>
        <result property="gender" column="gender"/>
        <result property="birthday" column="birthday"/>
        <result property="mobile" column="mobile"/>
        <result property="email" column="email"/>
        <result property="clinicId" column="clinic_id"/>
        <result property="deptId" column="dept_id"/>
        <result property="position" column="position"/>
        <result property="employStatus" column="employ_status"/>
        <result property="mobileLink" column="mobile_link"/>
        <result property="idType" column="id_type"/>
        <result property="idNumber" column="id_number"/>
        <result property="avatar" column="avatar"/>
        <result property="entryDate" column="entry_date"/>
        <result property="leaveDate" column="leave_date"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="status" column="status"/>
        <result property="clinicName" column="clinic_name"/>
        <result property="deptName" column="dept_name"/>
        <result property="roleNames" column="role_names"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectEmployeePage" resultMap="EmployeeResult">
        SELECT e.*,
               c.clinic_name,
               d.dept_name,
               (SELECT GROUP_CONCAT(r.role_name)
                FROM t_employee_role er
                         LEFT JOIN t_role r ON er.role_id = r.id AND r.is_delete = 0
                WHERE er.employee_id = e.id) AS role_names
        FROM t_employee e
                 LEFT JOIN t_clinic c ON e.clinic_id = c.id AND c.is_delete = 0
                 LEFT JOIN t_dept d ON e.dept_id = d.id AND d.is_delete = 0
        WHERE e.is_delete = 0
        <if test="keyword != null and keyword != ''">
            AND (e.name LIKE CONCAT('%', #{keyword}, '%')
                OR e.mobile LIKE CONCAT('%', #{keyword}, '%')
                OR e.emp_no LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test="clinicId != null">
            AND e.clinic_id = #{clinicId}
        </if>
        <if test="deptId != null">
            AND e.dept_id = #{deptId}
        </if>
        <if test="employStatus != null">
            AND e.employ_status = #{employStatus}
        </if>
        ORDER BY e.sort_order ASC, e.id ASC
    </select>
</mapper>
