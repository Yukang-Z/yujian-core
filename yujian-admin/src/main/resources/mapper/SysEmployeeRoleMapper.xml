<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yujian.admin.mapper.SysEmployeeRoleMapper">

    <delete id="deleteByEmployeeId">
        DELETE FROM t_employee_role WHERE employee_id = #{employeeId}
    </delete>

    <select id="selectRoleIdsByEmployeeId" resultType="java.lang.Long">
        SELECT role_id FROM t_employee_role WHERE employee_id = #{employeeId}
    </select>
</mapper>
